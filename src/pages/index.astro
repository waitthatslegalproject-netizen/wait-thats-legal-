---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const sortedArticles = articles.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featuredArticle = sortedArticles[0];
const latestArticles = sortedArticles.slice(1);
---

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wait, That's Legal?</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="top-bar">
            <p>LAW • TEENS • THE WORLD AROUND US</p>
        </div>

        <div class="logo">
            <h1>Wait, That's Legal?</h1>
            <p>Making the law make sense.</p>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="#">Latest</a>
            <a href="#">Technology</a>
            <a href="#">Rights</a>
            <a href="#">Education</a>
            <a href="#">Around the World</a>
            <a href="#">Compare</a>
            <a href="#">Law Tracker</a>
        </nav>

    </header>


    <!-- MAIN -->

    <main>

        <!-- INTRO -->

        <section class="intro">

            <p class="small-title">WELCOME TO</p>

            <h2>Wait, That's Legal?</h2>

            <p>
                Laws are everywhere. But most of us don't learn what they
                actually mean until they affect us.
            </p>

            <p>
                We break down laws, rights, and policy changes and explain
                what they actually mean for teenagers and young people.
            </p>

        </section>


        <!-- FEATURED ARTICLE -->

        {featuredArticle && (
            <section class="featured">

                <div class="featured-text">

                    <p class="category">
                        {featuredArticle.data.category}
                    </p>

                    <h2>
                        {featuredArticle.data.title}
                    </h2>

                    <p>
                        {featuredArticle.data.description}
                    </p>

                    <a
                        class="featured-button"
                        href={`/articles/${featuredArticle.id.replace(/\.md$/, "")}/`}
                    >
                        READ THE STORY →
                    </a>

                </div>


                <div class="featured-image">

                    {featuredArticle.data.image && (
                        <img
                            src={featuredArticle.data.image}
                            alt={featuredArticle.data.title}
                        />
                    )}

                </div>

            </section>
        )}


        <!-- LATEST ARTICLES -->

        <section class="latest">

            <div class="section-heading">

                <h2>Latest</h2>

                <a href="#">
                    View all →
                </a>

            </div>


            <div class="article-grid">

                {latestArticles.map((article) => (

                    <article>

                        <div class="article-image">

                            {article.data.image && (
                                <img
                                    src={article.data.image}
                                    alt={article.data.title}
                                />
                            )}

                        </div>


                        <p class="category">
                            {article.data.category}
                        </p>


                        <h3>
                            {article.data.title}
                        </h3>


                        <p>
                            {article.data.description}
                        </p>


                        <a
                            href={`/articles/${article.id.replace(/\.md$/, "")}/`}
                        >
                            Read more →
                        </a>

                    </article>

                ))}

            </div>

        </section>


        <!-- COMPARE -->

        <section class="compare">

            <p class="category">
                COMPARE
            </p>

            <h2>
                Same question. Different countries.
            </h2>

            <p>
                Laws aren't the same everywhere. Compare how different
                countries handle issues that affect young people.
            </p>

            <button>
                START COMPARING →
            </button>

        </section>


        <!-- LAW TRACKER -->

        <section class="tracker">

            <div>

                <p class="category">
                    LAW TRACKER
                </p>

                <h2>
                    What's changing?
                </h2>

                <p>
                    Follow important laws and policy changes and see
                    what they could mean for you.
                </p>

            </div>


            <div class="tracker-box">

                <h3>NEW</h3>

                <p>
                    Law changes coming soon.
                </p>

            </div>

        </section>

    </main>


    <!-- FOOTER -->

    <footer>

        <h2>
            Wait, That's Legal?
        </h2>

        <p>
            Laws. Teens. The world around us.
        </p>

        <div class="footer-links">

            <a href="#">About</a>
            <a href="#">Contact</a>
            <a href="#">Sources</a>
            <a href="#">Privacy</a>

        </div>

        <p class="copyright">
            © 2026 Wait, That's Legal?
        </p>

    </footer>

</body>

</html>
